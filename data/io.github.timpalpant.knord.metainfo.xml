<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.timpalpant.knord</id>

  <name>KNord</name>
  <summary>Native NordVPN client for Plasma</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <developer id="io.github.timpalpant">
    <name>Tim Palpant</name>
  </developer>

  <description>
    <p>
      KNord is a Kirigami front end for NordVPN, built for the Plasma desktop.
      It drives the official NordVPN command line client, so it needs no extra
      privileges and no Electron runtime, and it follows your Breeze theme,
      colour scheme and icon set.
    </p>
    <p>Features:</p>
    <ul>
      <li>Connection status with live uptime and transfer counters</li>
      <li>Quick Connect, or pick a country, city or specialty server group</li>
      <li>Kill Switch, Threat Protection Lite, post-quantum encryption and custom DNS</li>
      <li>Allowlist management for ports, port ranges and subnets</li>
      <li>Optional system tray icon with connect and disconnect</li>
    </ul>
    <p>
      KNord requires the NordVPN client to be installed and its daemon running.
      An active NordVPN subscription is needed to connect.
    </p>
  </description>

  <launchable type="desktop-id">io.github.timpalpant.knord.desktop</launchable>

